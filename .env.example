# Copy to .env and set real values (.env is gitignored)

# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-strong-password

# Application database connection (host must match the postgres service/container name)
DATABASE_URL=postgresql://user:change-me-strong-password@postgres:5432/appdb

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password

# Application image. Leave as app:latest to build locally, or set to a
# registry image (e.g. ghcr.io/<owner>/<repo>/app:latest) to pull on deploy.
APP_IMAGE=app:latest
